# YouTube to Text Configuration

# Server Port
PORT=8000

# Path to yt-dlp binary (defaults to yt-dlp on PATH)
YT_DLP_PATH=yt-dlp

# Whisper API Configuration (for speech-to-text fallback when captions are missing)
# Optional: if empty, speech-to-text fallback will return informative error if captions are missing
OPENAI_API_KEY=

# Translation configuration
TRANSLATION_PROVIDER=mymemory

